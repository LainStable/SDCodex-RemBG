{
  "id": "rembg",
  "name": "rembg",
  "version": "1.9.1",
  "description": "High-precision neural background removal, alpha matting, and batch processing powered by BiRefNet & RemBG.",
  "task_status": {
    "label": "RemBG",
    "path": "/rembg/api/batch/status",
    "page": "studio"
  },
  "author": "LainStable",
  "repository": "https://github.com/LainStable/SDCodex-RemBG",
  "icon": "auto_fix_high",
  "nav_items": [],
  "settings": [
    {
      "label": "RemBG",
      "page": "settings"
    }
  ],
  "volumes": [
    {
      "env_var": "REMBG_OUTPUT",
      "host_path": "./rembg_output",
      "container_path": "/data/rembg_output",
      "description": "Directory where processed cutout images and alpha masks are saved"
    },
    {
      "env_var": "HFH",
      "host_path": "./Huggingface",
      "container_path": "/data/huggingface",
      "description": "Cache directory for BiRefNet and neural model weights"
    }
  ],
  "entrypoint": "plugin:init_plugin",
  "assistant_actions": [
    {
      "name": "batch_status",
      "description": "Background-removal batch state and progress.",
      "method": "GET",
      "path": "/rembg/api/batch/status"
    },
    {
      "name": "cancel_batch",
      "description": "Cancel the running background-removal batch.",
      "method": "POST",
      "path": "/rembg/api/batch/cancel",
      "confirm": true
    }
  ]
}
